JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
API_PORT=4000
API_ORIGIN=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:4000/api
